{
  "manifest_version": 3,
  "name": "COMPR",
  "version": "0.3.0",
  "description": "Save and compare products across webshops, then check whether the same product is available for less.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.ecb.europa.eu/*",
    "https://taosgvfdnblnopaywimf.supabase.co/*"
  ],
  "web_accessible_resources": [{
    "resources": ["auth-receiver.html"],
    "matches": ["https://getcompr.nl/*"]
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "COMPR",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
